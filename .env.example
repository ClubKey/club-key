APP_NAME="Club Key"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://club-key.test

# Super admin user
APP_SUPER_ADMIN_NAME=admin
APP_SUPER_ADMIN_EMAIL=
APP_SUPER_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

#LOG_CHANNEL=nightwatch
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SMS Notifications
# Don't add this in test env.
# Ensure to create a .env.testing without these values,
# otherwise vonage will attempt to text notifications out to fake numbers.
# when running automated tests.
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=13365105872

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Remember to use a .env.testing for automated tests and use log mailer
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Square OAuth — register this exact redirect URL in the Square Developer Console (OAuth page):
# https://club-key.test/square/oauth/callback
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Leave empty to use APP_URL + /square/oauth/callback (recommended)
SQUARE_REDIRECT_URI=
SQUARE_OAUTH_SCOPES="MERCHANT_PROFILE_READ CUSTOMERS_READ CUSTOMERS_WRITE PAYMENTS_READ ORDERS_READ"
SQUARE_REFRESH_WITHIN_DAYS=7

NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
